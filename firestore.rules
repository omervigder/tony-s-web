rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = signed-in user whose email is whitelisted in the `admins` collection
    // with role 'admin'. Mirrors AuthContext.tsx, which gates the admin panel the same
    // way. (The `admin` custom claim is never set on the client, so a token-claim check
    // would always be false — we resolve admin status from Firestore instead.)
    // `email_verified` matters because the whitelist is keyed by address: without
    // it, any sign-in method that lets the caller assert an arbitrary email would
    // be enough to match an admin entry.
    function isAdmin() {
      let adminRef = /databases/$(database)/documents/admins/$(request.auth.token.email);
      return request.auth != null
          && request.auth.token.email_verified == true
          && exists(adminRef)
          && get(adminRef).data.role == 'admin';
    }

    // ── Public catalogue — guests browse freely ───────────────────────────
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Coupons — admin-only ──────────────────────────────────────────────
    // These used to be world-readable so the cart could look a code up
    // directly, which also let one query enumerate every code, value and
    // expiry in the store. Guests now resolve a code through the
    // `validateCouponCode` function, which answers about one code at a time
    // and is rate-limited against guessing.
    match /coupons/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ── Reviews — publicly readable, written server-side ──────────────────
    // Creates are denied to clients: an unauthenticated, unthrottled create
    // rule is an open invitation to automated posting, and rules cannot rate
    // limit. `submitReview` validates, throttles per caller, and takes the
    // product name from the catalog instead of from the submission.
    match /reviews/{id} {
      allow read: if true;
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    // ── Branding catalog (מיתוג) — guests need the labels and surcharges ──
    match /branding_options/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Homepage banners & arrival popup — guests must see them ───────────
    match /site_banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Store settings & content — guests need delivery cost, address ─────
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Site settings (legal pages, etc.) ────────────────────────────────
    match /siteSettings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Orders ────────────────────────────────────────────────────────────
    match /orders/{id} {
      // Client creates are denied outright. Guests used to write orders here
      // directly, which meant `total_price` was whatever the browser claimed —
      // rules can validate a shape but cannot recompute a price, so the only
      // check possible was `>= 0` and a crafted order bought the cart for ₪1.
      // Orders are now written by the `createOrder` Cloud Function, which prices
      // the cart from the catalog and runs under the Admin SDK (rules bypassed).
      allow create: if false;
      // Only whitelisted admins may read customer PII, mark paid, or delete
      allow read, update, delete: if isAdmin();
    }

    // ── Admins registry ───────────────────────────────────────────────────
    // A signed-in user may read only their own whitelist entry (the AuthContext
    // gate); admins may read the full registry. The whitelist is managed
    // out-of-band (Firebase console / grantAdminIfWhitelisted via the Admin SDK),
    // so client writes are denied.
    match /admins/{email} {
      allow read: if isAdmin() || (request.auth != null && request.auth.token.email == email);
      allow write: if false;
    }

    // ── Customer CRM ──────────────────────────────────────────────────────
    // Read-only to admins; rows are written server-side via the Admin SDK
    // (which bypasses rules), so client writes are denied.
    match /customers/{phone} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Deny everything not explicitly listed ─────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
