rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // ── Schema validation — guest-submitted order ─────────────────────────
    function isValidOrderCreate() {
      let d = request.resource.data;
      return d.customer_name is string
          && d.customer_name.size() >= 1
          && d.customer_name.size() <= 100
          && d.customer_phone is string
          && d.customer_phone.size() >= 7
          && d.customer_phone.size() <= 20
          && d.delivery_method in ['pickup', 'delivery']
          && d.total_price is number
          && d.total_price >= 0
          && d.items is list;
    }

    // ── Schema validation — guest-submitted review ────────────────────────
    function isValidReviewCreate() {
      let d = request.resource.data;
      return d.product_id is string
          && d.product_id.size() > 0
          && d.customer_name is string
          && d.customer_name.size() >= 1
          && d.customer_name.size() <= 100
          && d.rating is int
          && d.rating >= 1
          && d.rating <= 5
          && d.message is string
          && d.message.size() <= 1000;
    }

    // ── Public catalogue — guests browse freely ───────────────────────────
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Coupons — guests validate codes at checkout ───────────────────────
    match /coupons/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Reviews — guests read and submit (schema-validated) ──────────────
    match /reviews/{id} {
      allow read: if true;
      allow create: if isValidReviewCreate();
      allow update, delete: if isAdmin();
    }

    // ── Store settings & content — guests need delivery cost, address ─────
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Site settings (legal pages, etc.) ────────────────────────────────
    match /siteSettings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Orders — schema-validated guest create; admin read/update/delete ──
    match /orders/{id} {
      allow create: if isValidOrderCreate();
      allow read, update, delete: if isAdmin();
    }

    // ── Admins registry — admin eyes only ────────────────────────────────
    match /admins/{email} {
      allow read, write: if isAdmin();
    }

    // ── Customer CRM (populated by Cloud Function) — admin eyes only ──────
    match /customers/{phone} {
      allow read, write: if isAdmin();
    }

    // ── Deny everything not explicitly listed ─────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
