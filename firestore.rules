rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = signed-in user whose email is whitelisted in the `admins` collection
    // with role 'admin'. Mirrors AuthContext.tsx, which gates the admin panel the same
    // way. (The `admin` custom claim is never set on the client, so a token-claim check
    // would always be false — we resolve admin status from Firestore instead.)
    function isAdmin() {
      let adminRef = /databases/$(database)/documents/admins/$(request.auth.token.email);
      return request.auth != null
          && exists(adminRef)
          && get(adminRef).data.role == 'admin';
    }

    // ── Schema validation — guest-submitted order ─────────────────────────
    function isValidOrderCreate() {
      let d = request.resource.data;
      return d.customer_name is string
          && d.customer_name.size() >= 1
          && d.customer_name.size() <= 100
          && d.customer_phone is string
          && d.customer_phone.size() >= 7
          && d.customer_phone.size() <= 20
          && d.delivery_method in ['pickup', 'delivery']
          && d.total_price is number
          && d.total_price >= 0
          && d.items is list;
    }

    // ── Schema validation — guest-submitted review ────────────────────────
    function isValidReviewCreate() {
      let d = request.resource.data;
      return d.product_id is string
          && d.product_id.size() > 0
          && d.customer_name is string
          && d.customer_name.size() >= 1
          && d.customer_name.size() <= 100
          && d.rating is int
          && d.rating >= 1
          && d.rating <= 5
          && d.message is string
          && d.message.size() <= 1000;
    }

    // ── Public catalogue — guests browse freely ───────────────────────────
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Coupons — guests validate codes at checkout ───────────────────────
    match /coupons/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Reviews — guests read and submit (schema-validated) ──────────────
    match /reviews/{id} {
      allow read: if true;
      allow create: if isValidReviewCreate();
      allow update, delete: if isAdmin();
    }

    // ── Store settings & content — guests need delivery cost, address ─────
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Site settings (legal pages, etc.) ────────────────────────────────
    match /siteSettings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Orders ────────────────────────────────────────────────────────────
    match /orders/{id} {
      // Guests place orders (schema-validated, no auth required)
      allow create: if isValidOrderCreate();
      // Only whitelisted admins may read customer PII, mark paid, or delete
      allow read, update, delete: if isAdmin();
    }

    // ── Admins registry ───────────────────────────────────────────────────
    // A signed-in user may read only their own whitelist entry (the AuthContext
    // gate); admins may read the full registry. The whitelist is managed
    // out-of-band (Firebase console / grantAdminIfWhitelisted via the Admin SDK),
    // so client writes are denied.
    match /admins/{email} {
      allow read: if isAdmin() || (request.auth != null && request.auth.token.email == email);
      allow write: if false;
    }

    // ── Customer CRM ──────────────────────────────────────────────────────
    // Read-only to admins; rows are written server-side via the Admin SDK
    // (which bypasses rules), so client writes are denied.
    match /customers/{phone} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Deny everything not explicitly listed ─────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
